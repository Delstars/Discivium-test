{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public campus identity, theme preferences, and role display settings (non-PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "lecturer", "admin", "advisor"] },
        "scholarOsId": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "department": { "type": "string", "minLength": 1, "maxLength": 100 },
        "theme": { "type": "string", "minLength": 1, "maxLength": 32 },
        "fontScale": { "type": "string", "enum": ["small", "default", "large", "xl"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "scholarOsId", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for user email, emergency contact, and health clearance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "emergencyContact": { "type": "string", "maxLength": 160 },
        "medicalNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Real-time academic deadline, grade release, and service status notification.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1, "maxLength": 600 },
        "category": { "type": "string", "enum": ["deadline", "grade", "service", "finance", "system"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "body", "category", "read", "createdAt", "updatedAt"]
    },
    "ScholarPassport": {
      "title": "ScholarPassport",
      "description": "Lifelong Scholar Passport verified academic record and sharing permissions.",
      "type": "object",
      "properties": {
        "scholarOsId": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "holderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "institution": { "type": "string", "minLength": 1, "maxLength": 160 },
        "degreeTrack": { "type": "string", "minLength": 1, "maxLength": 160 },
        "shareWithEmployers": { "type": "boolean" },
        "shareWithUniversities": { "type": "boolean" },
        "shareGpa": { "type": "boolean" },
        "personalStatement": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scholarOsId", "ownerUid", "holderName", "institution", "shareWithEmployers", "shareWithUniversities", "createdAt", "updatedAt"]
    },
    "PassportDispute": {
      "title": "PassportDispute",
      "description": "Grade or credential record dispute submitted by passport owner.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseCode": { "type": "string", "minLength": 2, "maxLength": 24 },
        "reason": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "resolved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "courseCode", "reason", "status", "createdAt", "updatedAt"]
    },
    "InstitutionConfig": {
      "title": "InstitutionConfig",
      "description": "Institutional settings, AI feature gate, and branding policy.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "aiEnabled": { "type": "boolean" },
        "formsIntegrationEnabled": { "type": "boolean" },
        "chatIntegrationEnabled": { "type": "boolean" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "aiEnabled", "updatedByUid", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only governance and institutional action audit event.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "target": { "type": "string", "minLength": 1, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "target", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public campus profile and appearance preferences."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII record."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User notification inbox."
    },
    "/passports/{scholarOsId}": {
      "schema": { "$ref": "#/entities/ScholarPassport" },
      "description": "Lifelong Scholar Passport credential metadata and sharing controls."
    },
    "/passports/{scholarOsId}/disputes/{disputeId}": {
      "schema": { "$ref": "#/entities/PassportDispute" },
      "description": "Credential/grade dispute records."
    },
    "/institutions/{institutionId}": {
      "schema": { "$ref": "#/entities/InstitutionConfig" },
      "description": "Institutional feature flags and configuration."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable system audit log."
    }
  }
}
